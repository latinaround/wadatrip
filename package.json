{
  "name": "wadatrip-root",
  "private": true,
  "workspaces": [
    "apps/gateway",
    "services/*",
    "libs/*"
  ],
  "scripts": {
    "start:prod": "NODE_ENV=production GATEWAY_PORT=3000 node apps/gateway/dist/apps/gateway/src/main.js",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1 || bash ./scripts/dev-up.sh",
    "dev:gateway": "cross-env TS_NODE_PROJECT=apps/gateway/tsconfig.json ts-node-dev -r tsconfig-paths/register --respawn --transpile-only apps/gateway/src/main.ts",
    "dev:alerts": "cross-env TS_NODE_PROJECT=services/alerts/tsconfig.json ts-node-dev -r tsconfig-paths/register --respawn --transpile-only services/alerts/src/main.ts",
    "dev:gateway-only": "yarn dev:gateway",
    "prisma:generate": "prisma generate --schema libs/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema libs/db/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema libs/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema libs/db/prisma/schema.prisma",
    "seed": "cross-env TS_NODE_PROJECT=tsconfig.seed.json ts-node-dev --respawn --transpile-only libs/db/prisma/seed.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "smoke": "cross-env TS_NODE_PROJECT=tsconfig.seed.json ts-node-dev -r tsconfig-paths/register --transpile-only scripts/smoke.ts",
    "build": "yarn workspaces foreach --all --topological-dev run build",
    "build:all": "yarn workspaces foreach --topological-dev run build",
    "start": "cross-env NODE_ENV=production node apps/gateway/dist/apps/gateway/src/main.js",
    "postinstall": "echo 'Skipping Prisma auto-generate on Windows. Run manually with: npx prisma generate --schema=libs/db/prisma/schema.prisma'",
    "test:pricing": "jest apps/gateway/src/services/pricing.service.spec.ts",
    "build:gateway": "yarn workspace @wadatrip/service-gateway build",
    "start:gateway": "cross-env TS_NODE_PROJECT=apps/gateway/tsconfig.json ts-node -r tsconfig-paths/register apps/gateway/src/main.ts",
    "start:all": "concurrently -n pricing,itineraries,provider-hub,alerts,wadagent,gateway \"yarn workspace @wadatrip/service-pricing start\" \"yarn workspace @wadatrip/service-itineraries start\" \"yarn workspace @wadatrip/service-provider-hub start\" \"yarn workspace @wadatrip/service-alerts start\" \"yarn workspace @wadatrip/service-wadagent start\" \"yarn workspace @wadatrip/service-gateway start\""
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "axios-mock-adapter": "^1.21.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "jest": "^30.1.3",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.19.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.2.2"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/swagger": "^7.1.18",
    "@nestjs/websockets": "^10.0.0",
    "@prisma/client": "^6.19.0",
    "@types/node": "^24.5.2",
    "@types/react-router-dom": "^5.3.3",
    "@wadatrip/service-alerts": "workspace:*",
    "@wadatrip/service-gateway": "workspace:*",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "bullmq": "^5.63.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase": "^12.8.0",
    "form-data": "^4.0.4",
    "framer-motion": "^12.23.24",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.3.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "stripe": "^20.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0"
  },
  "packageManager": "yarn@3.6.4",
  "engines": {
    "node": ">=20.11.1 <21"
  }
}
