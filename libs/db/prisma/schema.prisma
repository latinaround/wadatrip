// ---------- Prisma base ----------
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Modelos ----------
model users {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password_hash String?
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  role          String    @default("traveler")
  status        String    @default("active")

  itineraries         itineraries[]
  alert_subscriptions alert_subscriptions[]
  bookings            bookings[]
  operator_listings   listings[]            @relation("OperatorListings")
  provider_profile    providers?           @relation("ProviderOwner")
  auth_login_codes    auth_login_codes[]

  @@index([email])
}

model auth_login_codes {
  id         String   @id @default(cuid())
  email      String
  code_hash  String
  role       String   @default("traveler")
  expires_at DateTime
  used_at    DateTime?
  attempts   Int      @default(0)
  created_at DateTime @default(now())
  user_id    String?

  user users? @relation(fields: [user_id], references: [id])

  @@index([email, created_at])
  @@index([expires_at])
  @@index([user_id])
}

model itineraries {
  id          String   @id @default(cuid())
  owner_id    String
  owner_type  String   @default("agent")
  agent_id    String?
  title       String
  origin      String
  destination String
  start_date  DateTime
  end_date    DateTime
  pax         Int
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("USD")
  operator_stripe_account_id String?
  status      String   @default("draft")
  created_at  DateTime @default(now())

  owner               users                 @relation(fields: [owner_id], references: [id])
  agent               providers?            @relation("AgentItineraries", fields: [agent_id], references: [id])
  versions            itinerary_versions[]
  alert_subscriptions alert_subscriptions[]

  @@index([owner_id], name: "idx_itin_owner")
  @@index([agent_id], name: "idx_itin_agent")
  @@index([destination, start_date], name: "idx_itin_dest_date")
}

model itinerary_versions {
  id             String   @id @default(cuid())
  itinerary_id   String
  scenario       String
  scenario_type  String?
  total_price    Decimal? @db.Decimal(12, 2)
  adred_action   String?
  items_json     Json?    @db.JsonB
  kpis           Json?    @db.JsonB
  created_at     DateTime @default(now())
  diff_from_prev Json?    @db.JsonB

  itinerary itineraries       @relation(fields: [itinerary_id], references: [id])
  items     itinerary_items[]

  @@index([itinerary_id, scenario], name: "idx_items_version")
}

model itinerary_items {
  id         String    @id @default(cuid())
  version_id String
  type       String
  supplier   String?
  provider   String?
  title      String?
  start_ts   DateTime?
  end_ts     DateTime?
  geo        Json?     @db.JsonB
  price      Decimal?  @db.Decimal(12, 2)
  currency   String?
  details    Json?     @db.JsonB

  version itinerary_versions @relation(fields: [version_id], references: [id])

  @@index([version_id], name: "idx_items_version_fk")
}

model alert_subscriptions {
  id               String    @id @default(cuid())
  user_id          String
  itinerary_id     String?
  rule             Json      @db.JsonB
  channel          String
  active           Boolean   @default(true)
  last_notified_at DateTime?
  created_at       DateTime  @default(now())

  user      users        @relation(fields: [user_id], references: [id])
  itinerary itineraries? @relation(fields: [itinerary_id], references: [id])
  alerts    alerts[]

  @@index([user_id], name: "idx_alerts_user")
  @@index([itinerary_id], name: "idx_alerts_itinerary")
  @@index([active], name: "idx_alerts_active")
}

model alerts {
  id              String   @id @default(cuid())
  subscription_id String?
  payload         Json     @db.JsonB
  status          String   @default("queued")
  created_at      DateTime @default(now())

  subscription alert_subscriptions? @relation(fields: [subscription_id], references: [id])

  @@index([subscription_id, status], name: "idx_alerts_status")
}

model adred_predictions {
  id            String   @id @default(cuid())
  route_key     String
  date_bucket   DateTime
  current_price Decimal? @db.Decimal(12, 2)
  predicted_low Decimal? @db.Decimal(12, 2)
  action        String?
  confidence    Float?
  horizon_days  Int?
  meta          Json?    @db.JsonB
  created_at    DateTime @default(now())

  @@index([route_key, date_bucket], name: "idx_adred_route_date")
}

// ---------- Provider Hub ----------
model providers {
  id                String   @id @default(cuid())
  user_id           String?  @unique
  type              String
  name              String
  email             String   @unique
  phone             String?
  languages         String[]
  base_city         String
  country_code      String
  ratings_avg       Float    @default(0)
  ratings_count     Int      @default(0)
  status            String   @default("pending")
  photo_url         String?
  instagram_handle  String?
  bio_short         String?  @db.Text
  verified_level    String   @default("community")
  license_url       String?
  approved_at       DateTime?
  approved_by       String?
  created_at        DateTime @default(now())
  stripe_account_id String?

  // Identity verification fields
  verification_status String?  @default("pending")
  verification_score  Float?
  risk_level          String?
  detected_name       String?
  document_valid      Boolean? @default(false)
  extracted_country   String?
  extracted_id_number String?
  match_faces         Boolean? @default(false)
  verification_notes  String?

  owner       users?                @relation("ProviderOwner", fields: [user_id], references: [id])
  documents provider_documents[]
  listings  listings[]
  bookings  bookings[]
  itineraries itineraries[] @relation("AgentItineraries")

  @@index([status], name: "idx_providers_status")
  @@index([user_id], name: "idx_providers_user")
  @@index([base_city, country_code], name: "idx_providers_city_country")
}

model listings {
  id               String    @id @default(cuid())
  provider_id      String
  operator_id      String?
  title            String
  description      String?   @db.Text
  category         String
  city             String
  country_code     String
  duration_minutes Int?
  price_from       Decimal?  @db.Decimal(12, 2)
  currency         String    @default("USD")
  start_date       DateTime?
  end_date         DateTime?
  tags             String[]
  status           String    @default("pending")
  cover_image_url  String?
  created_at       DateTime  @default(now())

  provider     providers              @relation(fields: [provider_id], references: [id])
  operator     users?                 @relation("OperatorListings", fields: [operator_id], references: [id])
  availability listing_availability[]
  bookings     bookings[]

  @@index([provider_id], name: "idx_listings_provider")
  @@index([city, country_code, category, status], name: "idx_listings_search")
  @@index([status], name: "idx_listings_status")
  @@index([operator_id], name: "idx_listings_operator")
}

model provider_documents {
  id          String   @id @default(cuid())
  provider_id String
  doc_type    String
  url         String
  status      String   @default("pending")
  notes       String?
  created_at  DateTime @default(now())

  provider providers @relation(fields: [provider_id], references: [id])

  @@index([provider_id], name: "idx_provider_docs_provider")
}

model listing_availability {
  id              String   @id @default(cuid())
  listing_id      String
  date            DateTime
  spots_total     Int
  spots_available Int

  listing listings @relation(fields: [listing_id], references: [id])

  @@index([listing_id, date], name: "idx_listing_availability_date")
}

// ---------- Bookings ----------
model bookings {
  id                   String   @id @default(cuid())
  listing_id           String
  provider_id          String
  user_id              String
  status               String   @default("pending")
  date                 DateTime
  num_people           Int
  total_price          Decimal? @db.Decimal(12, 2)
  amount_cents         Int?
  operator_share_cents Int?
  commission_cents     Int?
  currency             String?  @default("usd")
  payment_status       String?
  checkout_session_id  String?
  payment_intent_id    String?
  created_at           DateTime @default(now())

  listing  listings  @relation(fields: [listing_id], references: [id])
  provider providers @relation(fields: [provider_id], references: [id])
  user     users     @relation(fields: [user_id], references: [id])

  @@index([provider_id, status, date], name: "idx_bookings_provider_status_date")
  @@index([user_id, status], name: "idx_bookings_user_status")
}

model destination_covers {
  id           String   @id @default(cuid())
  slug         String   @unique
  city         String
  country_code String?
  title        String?
  image_url    String
  eyebrow      String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())

  @@index([city, country_code, active], name: "idx_destination_covers_city_country_active")
  @@index([active], name: "idx_destination_covers_active")
}

model operator_leads {
  id                 String   @id @default(cuid())
  name               String
  category           String?
  address            String?
  website            String?
  phone              String?
  rating             Float?
  reviews_count      Int      @default(0)
  latitude           Float?
  longitude          Float?
  city               String
  country            String
  source_query       String
  source             String   @default("outscraper_google_maps")
  email              String?
  instagram          String?
  whatsapp           String?
  lead_status        String   @default("new")
  lead_quality       String?
  website_normalized String?
  phone_normalized   String?
  name_normalized    String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([city, country], name: "idx_operator_leads_city_country")
  @@index([category], name: "idx_operator_leads_category")
  @@index([rating], name: "idx_operator_leads_rating")
  @@index([lead_status], name: "idx_operator_leads_status")
  @@index([created_at], name: "idx_operator_leads_created_at")
  @@index([website_normalized], name: "idx_operator_leads_website_norm")
  @@index([phone_normalized], name: "idx_operator_leads_phone_norm")
  @@index([name_normalized, city, country], name: "idx_operator_leads_name_city_country")
}

model PaymentEvent {
  id           String   @id
  type         String
  payload      Json
  processed_at DateTime?
  created_at   DateTime @default(now())
}

model PaymentRecord {
  id                         String   @id @default(cuid())
  booking_id                 String   @unique
  provider_id                String
  amount_gross_cents         Int
  commission_cents           Int
  amount_net_cents           Int
  currency                   String
  stripe_payment_intent_id   String?
  stripe_checkout_session_id String?
  status                     String   @default("pending")
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt
}

model OperatorWallet {
  id             String   @id @default(cuid())
  operatorId     String   @unique
  totalEarned    Int      @default(0)
  totalReleased  Int      @default(0)
  pendingPayouts Int      @default(0)
  commission     Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}


