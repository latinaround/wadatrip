{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",        // 👈 fuerza resolución clásica
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "baseUrl": "../../",
    "paths": {
      "@wadatrip/common": ["libs/common/src/index.ts"],
      "@wadatrip/common/*": ["libs/common/src/*"],
      "@wadatrip/db": ["libs/db/src/index.ts"],
      "@wadatrip/db/*": ["libs/db/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma", "**/*.spec.ts", "**/*.test.ts"]
}
