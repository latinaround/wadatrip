{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@wadatrip/common": ["../../libs/common/dist/index"],
      "@wadatrip/common/*": ["../../libs/common/dist/*"],
      "@wadatrip/connectors": ["../../libs/connectors/dist/index"],
      "@wadatrip/connectors/*": ["../../libs/connectors/dist/*"],
      "@wadatrip/pricing": ["../../libs/pricing/dist/index"],
      "@wadatrip/pricing/*": ["../../libs/pricing/dist/*"],
      "@wadatrip/db": ["../../libs/db/dist/index"],
      "@wadatrip/db/*": ["../../libs/db/dist/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
