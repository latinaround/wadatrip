services:
  - type: web
    name: wadatrip-backend
    env: node
    rootDir: .
    buildCommand: |
      YARN_ENABLE_SCRIPTS=0 node .yarn/releases/yarn-4.9.4.cjs install
      node .yarn/releases/yarn-4.9.4.cjs prisma generate --schema libs/db/prisma/schema.prisma
      node .yarn/releases/yarn-4.9.4.cjs workspaces foreach --all --topological-dev run build
      YARN_ENABLE_SCRIPTS=0 node .yarn/releases/yarn-4.9.4.cjs workspaces focus @wadatrip/service-gateway --production
    startCommand: node .yarn/releases/yarn-4.9.4.cjs start:all
    healthCheckPath: /health
    envVars:
      - key: NODE_VERSION
        value: 20.11.1
      - key: NODE_ENV
        value: production
      - key: DATABASE_URL
        sync: false
      - key: STRIPE_SECRET_KEY
        sync: false
      - key: STRIPE_PUBLISHABLE_KEY
        sync: false
      - key: STRIPE_WEBHOOK_SECRET
        sync: false
      - key: ITINERARIES_URL
        value: http://localhost:3011
      - key: PRICING_SERVICE_URL
        value: http://localhost:3012
      - key: PROVIDER_HUB_URL
        value: http://localhost:3014
      - key: OPERATOR_LEADS_URL
        value: http://localhost:3023
      - key: ALERTS_URL
        value: http://localhost:3013
      - key: WADAGENT_URL
        value: http://localhost:3022
      - key: MISTRAL_API_KEY
        sync: false
      - key: MISTRAL_MODEL
        value: mistral-small-latest
